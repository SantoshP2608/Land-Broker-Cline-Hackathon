APP_ENV=development
DATABASE_URL=postgresql+psycopg://land_demo@127.0.0.1:55432/land_demo
SESSION_SECRET=local-synthetic-demo-only-change-before-sharing
SIMULATOR_SECRET=local-simulator-demo-only-change-before-sharing
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
STORAGE_PATH=../.private-storage
OFFICIAL_INTEGRATION_MODE=SIMULATED
POLICY_STATE_CODE=KA
DISCUSSION_RESPONSE_HOURS=24
EVIDENCE_RESPONSE_HOURS=48
OFFICIAL_CHECK_MAX_AGE_SECONDS=300

# Actual Cline SDK extraction; government records still remain SIMULATED.
DOCUMENT_EXTRACTION_BACKEND=CLINE_SDK
CLINE_PROVIDER_ID=
CLINE_MODEL_ID=
CLINE_API_KEY=
CLINE_BASE_URL=
CLINE_NODE_EXECUTABLE=node
CLINE_TIMEOUT_SECONDS=60
CLINE_MIN_CONFIDENCE=0.80